# Copy this file to `.env.local` and fill in the real values.
# `.env.local` is gitignored - never commit real credentials.

# Neon Postgres, POOLED connection (host contains `-pooler`).
# Used by the application at runtime through `pg.Pool`. The PgBouncer endpoint
# keeps serverless/edge-adjacent connection counts under control.
DATABASE_URL="postgresql://USER:PASSWORD@ep-example-123456-pooler.us-east-2.aws.neon.tech/rivet?sslmode=require"

# Neon Postgres, DIRECT (unpooled) connection - same host without `-pooler`.
# Used by `pnpm db:migrate` and `pnpm db:studio`. DDL through PgBouncer in
# transaction pooling mode is unreliable, so migrations bypass the pooler.
# When this is unset, migrations fall back to DATABASE_URL - which is how CI
# points them at the ephemeral Neon branch it creates per pull request.
DATABASE_URL_UNPOOLED="postgresql://USER:PASSWORD@ep-example-123456.us-east-2.aws.neon.tech/rivet?sslmode=require"

# Upstash Redis, used by BullMQ. `rediss://` (two s) is TLS, which Upstash
# requires. Redis is a delivery mechanism only - Postgres is the source of truth
# for job state - so losing this database loses no jobs.
#
# Cost note: BullMQ polls Redis even when the queue is idle and Upstash bills per
# command, so leaving a worker running overnight is not free. `drainDelay` is set
# to 30s in the worker to cut the idle rate; beyond that, stop the worker when you
# are not developing, and prefer a Fixed plan over pay-as-you-go.
REDIS_URL="rediss://default:PASSWORD@fitting-mammal-12345.upstash.io:6379"

# --- GitHub App -------------------------------------------------------------
# Stage 0 creates the App and installs it on the throwaway demo repository.
# Leave these blank for CI and for RIVET_GITHUB=off. Never commit real values.
# The private key is the App's PEM file encoded as one base64 string, not the
# PEM text itself, so newlines survive environment loading.
#
# `app` turns on publication in the worker AND the repository and issue pickers
# in the web app. Off by default and off in CI; with it off, the create form
# keeps the manual repository URL it has always had and a run ends at its
# validated diff. The web app additionally treats missing App credentials as
# off, so `next build` on a bare machine still works.
# The worker REFUSES TO START with `off` when NODE_ENV=production, for the same
# reason RIVET_SANDBOX and RIVET_AGENT do, and this is the one that hides best:
# every phase runs for real, the job reports `completed`, and the one thing it
# exists to produce - a pull request - was never created.
#
# With `app`, GITHUB_APP_ID and GITHUB_APP_PRIVATE_KEY are REQUIRED and checked
# at startup rather than at publication: `finalizing` is the last phase, so
# discovering a missing credential there fails a job whose work was already
# written, validated and approved.
RIVET_GITHUB="off"
GITHUB_APP_ID=""

# The App's .pem file as ONE base64 string, not the PEM text - a multi-line
# value does not survive most environment loaders, and a half-loaded key fails
# later as an unreadable signature rather than as a configuration problem:
#
#   base64 -i your-app.private-key.pem | tr -d '\n'
GITHUB_APP_PRIVATE_KEY=""
GITHUB_APP_SLUG=""
GITHUB_APP_CLIENT_ID=""

# Host Git budgets, deliberately not the SANDBOX_* ones. These cover the clone,
# archive, apply, commit and push that run on the WORKER HOST with a short-lived
# installation token; the sandbox timeouts cover an unauthenticated clone inside
# a container. Different operations, on different machines, with different
# reasons to be slow.
GITHUB_CLONE_TIMEOUT_MS="180000"
GITHUB_PUSH_TIMEOUT_MS="180000"

# Bound on the complete seed archive for a private repository, applied before it
# crosses into the sandbox. A repository large enough to matter is a real limit
# of the seeding design; this is what makes hitting it a stated failure rather
# than a worker heap problem. 256MiB.
GITHUB_SEED_MAX_BYTES="268435456"

# Absolute base URL of the web app, used for the "view the Rivet run" link in a
# published pull request body. Without it the body falls back to a relative
# /jobs/<id>, which is correct inside Rivet and resolves against github.com in a
# pull request - so a deployment that publishes should set this.
RIVET_APP_URL="http://localhost:3000"

# --- Evaluation harness (M10) ------------------------------------------------
# The fourth member of the RIVET_SANDBOX / RIVET_AGENT / RIVET_GITHUB family,
# and the only one that WIDENS what a worker will run against: with `on`, a job
# whose repoUrl is `rivet-local:<case-id>` is seeded from a bare repository this
# host built with `pnpm eval:build` instead of from a remote.
#
# The worker REFUSES TO START with `on` when NODE_ENV=production. Nothing a
# browser can submit reaches this path either - createJobSchema.repoUrl is
# https-only - and the scheme carries a case id rather than a path, resolved
# below the fixture root with symlink escape refused.
RIVET_EVAL="off"

# Where the git-tracked benchmark cases live, and where `pnpm eval:build` writes
# the `<case-id>.git` bare repositories a job is actually seeded from. Relative
# paths resolve against the repository root, never the current directory.
RIVET_BENCHMARK_ROOT="benchmarks"
RIVET_BENCHMARK_FIXTURE_ROOT=".rivet/benchmarks"

# Host clone and archive budgets for a local fixture, mirroring the GitHub ones
# and deliberately separate from them: this operation touches no network.
RIVET_EVAL_CLONE_TIMEOUT_MS="180000"
RIVET_EVAL_SEED_MAX_BYTES="268435456"

# Maximum number of evaluation jobs the runner keeps in flight. This is the
# runner's bound, independent of the worker's own concurrency.
RIVET_EVAL_CONCURRENCY="1"

# --- Telemetry (M11) ---------------------------------------------------------
# The fifth member of the switch family and the only one whose cheap variant is
# LEGAL in production: `off` costs visibility, not work. Both deployables read
# it - the worker through parseWorkerConfig, the web app through
# resolveWebTelemetryConfig - and `otlp` exports OTLP/HTTP JSON to the collector
# below. Nothing needs to be listening there: an export that cannot connect is
# logged and dropped, and never fails a job.
RIVET_TELEMETRY="off"

# The collector's BASE url; `/v1/traces` and `/v1/metrics` are appended. This is
# the standard OpenTelemetry variable rather than a RIVET_ one, because every
# collector's documentation already uses this name. Must be an http(s) URL.
OTEL_EXPORTER_OTLP_ENDPOINT="http://localhost:4318"

# How often metrics are pushed, and the budget for one OTLP POST. The timeout is
# deliberately short: it is spent inside a shutdown, and a collector that has
# stopped answering must not hold a worker's exit open.
RIVET_TELEMETRY_EXPORT_INTERVAL_MS="15000"
RIVET_TELEMETRY_EXPORT_TIMEOUT_MS="10000"

# `service.version` on every span and metric. Set it to something that changes
# when the code does - a commit sha - because the first question after a
# regression is which build the slow spans came from.
RIVET_SERVICE_VERSION="0.0.0-dev"

# --- Worker -----------------------------------------------------------------
# All optional; the defaults shown are what the worker uses when they are unset.
# Parsed through Zod at startup, and the worker exits non-zero on anything
# invalid rather than booting into a configuration that corrupts job state.

# Jobs this worker runs at once.
WORKER_CONCURRENCY="2"

# The lease protocol. HEARTBEAT * 3 <= LEASE is asserted at startup: a worker
# must be able to miss two heartbeats and still own its job, or the sweeper will
# reclaim work from a process that is perfectly healthy.
WORKER_LEASE_SECONDS="30"
WORKER_HEARTBEAT_SECONDS="10"

# How long SIGTERM waits for in-flight jobs to be handed back before forcing an
# exit. A wedged job must not be able to block a deploy forever.
WORKER_SHUTDOWN_GRACE_MS="15000"

# The sweeper: how often a reconciliation pass runs, and how many times a job may
# be claimed before an expired lease fails it instead of reclaiming it again.
#
# 60 seconds, not 10. A sweep is a Postgres query on a schedule, and Neon's
# compute endpoint will not autosuspend while something keeps querying it - so a
# chattier sweeper quietly spends the free tier's monthly compute allowance on
# finding nothing. Stop the worker when you are not developing.
WORKER_SWEEP_INTERVAL_MS="60000"
WORKER_MAX_ATTEMPTS="3"

# Simulation knob for the phases that are still not real. Scales their
# durations: 1 runs the ~21-second demo, 0 makes those phases instant.
RIVET_PIPELINE_SPEED="1"

# Defaults for jobs created by worker-side demos. Jobs persist these values, so
# a replacement worker cannot change whether review runs or refund a loop.
RIVET_REVIEW_MODE="independent"
RIVET_MAX_REVIEW_LOOPS="2"

# Cap on one stored artifact - a diff, a summary - before it is truncated to its
# head and tail. Its own bound rather than SANDBOX_MAX_OUTPUT_BYTES, because a
# command transcript is a log while an artifact is the run's work product. The
# true size is kept on the row either way, so a truncated artifact still says how
# big it really was.
RIVET_ARTIFACT_MAX_BYTES="262144"

# Complete gzip workspace checkpoints. Unlike artifacts, checkpoints are never
# head/tail truncated: a patch above this bound is rejected as unsafe to resume.
RIVET_CHECKPOINT_MAX_BYTES="4194304"
RIVET_CHECKPOINT_TIMEOUT_MS="30000"

# Fault injection, for breaking a job on purpose. Both must be set together or
# the worker refuses to start. The phase is a job status; the mode is one of:
#
#   throw        a retryable error -> the job is retried with backoff
#   fatal        a terminal repo_unavailable error -> no retry
#   hang         ignore the job deadline -> timed_out
#   exit         process.exit(1) -> lease expiry and sweeper recovery
#   no-daemon    sandbox_unavailable during create -> retries, then fails
#   oom          allocate until the sandbox memory limit kills the command
#   slow-command exceed the command's own timeout -> command_timed_out
#
# The sandbox-specific modes need RIVET_SANDBOX=docker to exercise the real
# provider. With RIVET_SANDBOX=off they fall back to their named error.
RIVET_FAULT_PHASE=""
RIVET_FAULT_MODE=""

# trace | debug | info | warn | error | fatal
LOG_LEVEL="info"

# --- Sandbox ----------------------------------------------------------------
# Milestone 2. `provisioning` and `testing` are real: a job creates a container,
# clones the repository into it, installs its dependencies and runs the
# repository's own test suite. The other five phases are still sleeps.
#
# All optional. Every value below is the default.

# docker | off
#
# `off` selects the Milestone 1 simulated pipeline - seven sleeps, no daemon -
# which is what the integration suite runs under and what a machine with no
# Docker should use. The worker REFUSES TO START with `off` when
# NODE_ENV=production: a worker that completes every job without doing any work
# looks entirely healthy, which is the worst failure mode available.
RIVET_SANDBOX="docker"

# The base image, pinned by digest as well as by tag so an upstream retag cannot
# silently change what a job runs. This digest is an OCI index covering arm64
# and amd64, so the one pin resolves on Apple silicon and on CI's runners.
#
# Not `-slim`: that image ships no `git`, the clone fails with "executable file
# not found", and the job blames the repository for Rivet's own missing tool.
SANDBOX_IMAGE="node@sha256:934240a162082fd8b8a2f90cd5114446443f1eba1c5378f6687167ca405e6584"

# Where the clone lands. Its parent must already be writable by uid 1000 -
# Docker creates a missing working directory as root and never chowns it - which
# `/home/node` is and `/` is not.
SANDBOX_WORKDIR="/home/node/workspace"

# Resource limits, enforced by the container runtime. Memory is a hard limit
# with swap disabled, so exceeding it is an OOM kill rather than a slow job.
SANDBOX_MEMORY_MB="2048"
SANDBOX_CPUS="2"
SANDBOX_PIDS_LIMIT="512"

# Five budgets, because there are distinct kinds of slow and only some are a
# symptom. A command that blows its own budget is `command_timed_out`, which is
# distinct from the whole job blowing `max_duration_seconds`.
SANDBOX_COMMAND_TIMEOUT_MS="120000"
SANDBOX_CLONE_TIMEOUT_MS="180000"
SANDBOX_INSTALL_TIMEOUT_MS="300000"
SANDBOX_BASELINE_TIMEOUT_MS="300000"
SANDBOX_CHECK_TIMEOUT_MS="180000"

# Cap on each of stdout and stderr per command. Above this the transcript keeps
# its head and its tail with an explicit count of the elided bytes in between -
# a transcript that silently loses its ending is worse than one that says it did.
SANDBOX_MAX_OUTPUT_BYTES="65536"

# Cap on one `git diff` read, and deliberately not the one above. The ordinary
# cap is tuned for transcripts and sits below RIVET_ARTIFACT_MAX_BYTES, so a diff
# read through it would arrive already clipped - and the artifact would then
# record the clipped length as its true size, which is the exact thing that
# column exists to prevent. Keep this above the artifact bound.
RIVET_DIFF_MAX_BYTES="1048576"

# JSON test reporters write outside the repository and are read through the
# sandbox file API under this complete-read cap. Keep it above the artifact
# bound so malformed JSON means a real reporter problem, not early truncation.
RIVET_VALIDATION_REPORT_MAX_BYTES="4194304"

# A convention-based targeted run is skipped rather than expanding into a
# misleading second full-suite run when selection exceeds this many files.
RIVET_TARGETED_MAX_FILES="25"

# How old a container must be before the reaper treats it as abandoned. The
# reaper asks Postgres whether a container's job is still running, and a
# container created moments ago may belong to a job whose row is not written yet
# - reaping that would be the reaper causing the failure it exists to clean up
# after. `pnpm demo:recovery` compresses this so the container its killed worker
# orphaned is provably gone before the demo ends.
SANDBOX_REAP_GRACE_MS="120000"

# Where the Docker daemon is. Unset probes `~/.docker/run/docker.sock` (Docker
# Desktop) and then `/var/run/docker.sock`. Only `unix://` is supported.
DOCKER_HOST=""

# --- Coding agent -----------------------------------------------------------
# Milestone 4. `implementing` starts a Pi session against the job's sandbox and
# gives it exactly four tools - read, write, edit, bash - every one of which
# executes inside the container.
#
# The topology worth knowing: the harness runs on the WORKER HOST and holds the
# model key; its tools run in the container, which has no credentials and no
# route to a model provider. Inference traffic and repository traffic never
# meet.

# pi | off | scripted
#
# `off` leaves `implementing` as the Milestone 1 sleep, which is what a machine
# with no key and the integration suite use. `scripted` loads a CodingAgent from
# RIVET_AGENT_SCRIPT and calls no provider at all; it exists for
# `pnpm demo:recovery`, where the run under demonstration is the recovery and a
# model sampling differently twice would only add a way for it to fail. The
# worker REFUSES TO START with either one when NODE_ENV=production, for the same
# reason RIVET_SANDBOX does: a system that completes every job without writing
# any code looks healthy.
RIVET_AGENT="pi"

# The module supplying the agent under RIVET_AGENT=scripted, as a path. It must
# export `createCodingAgent(): CodingAgent`. Required by that mode and REFUSED by
# the others - a script named without the mode looks canned while quietly calling
# the real provider on every job, which is the expensive half of that mistake.
RIVET_AGENT_SCRIPT=""

# The model, and the provider that serves it. Cheap on purpose - a debugging
# loop should not be a budget conversation - and present in the harness's own
# catalog with its rates, which is what makes the per-job cost ceiling
# enforceable rather than aspirational.
RIVET_MODEL="deepseek/deepseek-v4-flash"
RIVET_MODEL_PROVIDER="openrouter"

# REQUIRED when RIVET_AGENT=pi and the provider is openrouter. The worker
# refuses to boot without it, rather than discovering it on the first job after
# a container and a clone have already been paid for.
OPENROUTER_API_KEY=""

# The session's own deadline and turn ceiling. Distinct from the job's
# `max_duration_seconds`: "this job is slow" and "the model has stopped making
# progress" are different failures with different fixes. The per-job spend,
# model-call and tool-call ceilings live on the job row, not here.
AGENT_SESSION_TIMEOUT_MS="900000"
AGENT_MAX_TURNS="40"

# What one shell command hands back to the MODEL - not what is stored. The
# durable transcript keeps SANDBOX_MAX_OUTPUT_BYTES, because a human debugging a
# job later wants the whole thing while a megabyte of build log in a context
# window is a megabyte of budget spent on noise.
AGENT_TOOL_OUTPUT_MAX_BYTES="32768"

# Cap on one file read out of the sandbox, and on any single piece of session
# text that reaches the timeline.
AGENT_FILE_MAX_BYTES="262144"
AGENT_PREVIEW_MAX_BYTES="2048"

# A Rivet-owned config directory for the harness, deliberately NOT `~/.pi`. A
# harness pointed at your own config directory mixes your machine into every job
# this worker runs, which makes a run unreproducible and is close to the most
# confusing bug available here.
AGENT_HOME_DIR=""
