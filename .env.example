# Copy this file to `.env.local` and fill in the real values.
# `.env.local` is gitignored - never commit real credentials.

# Neon Postgres, POOLED connection (host contains `-pooler`).
# Used by the application at runtime through `pg.Pool`. The PgBouncer endpoint
# keeps serverless/edge-adjacent connection counts under control.
DATABASE_URL="postgresql://USER:PASSWORD@ep-example-123456-pooler.us-east-2.aws.neon.tech/rivet?sslmode=require"

# Neon Postgres, DIRECT (unpooled) connection - same host without `-pooler`.
# Used by `pnpm db:migrate` and `pnpm db:studio`. DDL through PgBouncer in
# transaction pooling mode is unreliable, so migrations bypass the pooler.
# When this is unset, migrations fall back to DATABASE_URL - which is how CI
# points them at the ephemeral Neon branch it creates per pull request.
DATABASE_URL_UNPOOLED="postgresql://USER:PASSWORD@ep-example-123456.us-east-2.aws.neon.tech/rivet?sslmode=require"

# Upstash Redis, used by BullMQ. `rediss://` (two s) is TLS, which Upstash
# requires. Redis is a delivery mechanism only - Postgres is the source of truth
# for job state - so losing this database loses no jobs.
#
# Cost note: BullMQ polls Redis even when the queue is idle and Upstash bills per
# command, so leaving a worker running overnight is not free. `drainDelay` is set
# to 30s in the worker to cut the idle rate; beyond that, stop the worker when you
# are not developing, and prefer a Fixed plan over pay-as-you-go.
REDIS_URL="rediss://default:PASSWORD@fitting-mammal-12345.upstash.io:6379"

# --- Worker -----------------------------------------------------------------
# All optional; the defaults shown are what the worker uses when they are unset.
# Parsed through Zod at startup, and the worker exits non-zero on anything
# invalid rather than booting into a configuration that corrupts job state.

# Jobs this worker runs at once.
WORKER_CONCURRENCY="2"

# The lease protocol. HEARTBEAT * 3 <= LEASE is asserted at startup: a worker
# must be able to miss two heartbeats and still own its job, or the sweeper will
# reclaim work from a process that is perfectly healthy.
WORKER_LEASE_SECONDS="30"
WORKER_HEARTBEAT_SECONDS="10"

# How long SIGTERM waits for in-flight jobs to be handed back before forcing an
# exit. A wedged job must not be able to block a deploy forever.
WORKER_SHUTDOWN_GRACE_MS="15000"

# Milestone 1 simulation knob, deleted when the sandbox lands in M2. Scales every
# phase duration: 1 runs the ~21-second demo, 0 makes a whole job instant.
RIVET_PIPELINE_SPEED="1"

# trace | debug | info | warn | error | fatal
LOG_LEVEL="info"
