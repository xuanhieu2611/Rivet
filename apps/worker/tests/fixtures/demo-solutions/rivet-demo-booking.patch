diff --git a/test/booking.test.js b/test/booking.test.js
index 32cf9215f8b96aecfa2c6b25bf803013e6095842..de612ba91d933963220ee727cd454f11c458ba35 100644
--- a/test/booking.test.js
+++ b/test/booking.test.js
@@ -58,3 +58,32 @@ test("rejects a sequential overlapping booking", async (t) => {
 
   assert.equal(conflict.status, 409);
 });
+
+test("allows only one of two concurrent overlapping bookings", async (t) => {
+  let arrivals = 0;
+  let release;
+  const ready = new Promise((resolve) => {
+    release = resolve;
+  });
+  const app = createBookingApp({
+    hooks: {
+      afterAvailabilityCheck: async () => {
+        arrivals += 1;
+        if (arrivals === 2) release();
+        await ready;
+      },
+    },
+  });
+  t.after(() => app.close());
+
+  const results = await Promise.all([
+    app.handleRequest({ method: "POST", path: "/bookings", body: MORNING }),
+    app.handleRequest({
+      method: "POST",
+      path: "/bookings",
+      body: { ...MORNING, guestName: "Grace" },
+    }),
+  ]);
+
+  assert.deepEqual(results.map(({ status }) => status).sort(), [201, 409]);
+});
