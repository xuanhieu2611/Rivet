@@ -41,3 +41,19 @@ test("returns 409 when the reservation is already cancelled", () => {
 
   assert.equal(response.status, 409);
 });
+
+test("scopes duplicate references to the customer", () => {
+  const app = createReservationApp([
+    { id: "r-alice", customerId: "alice", reference: "SHARED", status: "confirmed" },
+    { id: "r-bob", customerId: "bob", reference: "SHARED", status: "confirmed" },
+  ]);
+
+  const response = app.handleRequest({
+    method: "POST",
+    path: "/customers/bob/reservations/SHARED/cancel",
+  });
+
+  assert.equal(response.status, 200);
+  assert.equal(response.body.reservation.id, "r-bob");
+  assert.equal(app.store.snapshot()[0].status, "confirmed");
+});
