     return this.store.cancel(reservation.id);
diff --git a/src/reservation-store.js b/src/reservation-store.js
index 9836a2fa73de9d0be8fe830e3ad6733a01695507..ea0787e62883fe950714db4569baf6051742624f 100644
--- a/src/reservation-store.js
+++ b/src/reservation-store.js
@@ -3,8 +3,13 @@ export class ReservationStore {
     this.reservations = reservations.map((reservation) => ({ ...reservation }));
   }
 
-  findByReference(reference) {
-    return this.reservations.find((reservation) => reservation.reference === reference) ?? null;
+  findByCustomerAndReference(customerId, reference) {
+    return (
+      this.reservations.find(
+        (reservation) =>
+          reservation.customerId === customerId && reservation.reference === reference,
+      ) ?? null
+    );
   }
 
   cancel(id) {
