{
  "$schema": "https://turbo.build/schema.json",
  "globalDependencies": [
    ".nvmrc",
    "packages/config/tsconfig.base.json",
    "packages/config/eslint.base.js"
  ],
  "globalEnv": ["NODE_ENV"],
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "outputs": [".next/**", "!.next/cache/**", "dist/**"]
    },
    "dev": {
      "dependsOn": ["^build"],
      "cache": false,
      "persistent": true
    },
    "lint": {
      "dependsOn": ["^build"],
      "outputs": []
    },
    "typecheck": {
      "dependsOn": ["^build"],
      "outputs": []
    },
    "test": {
      "dependsOn": ["^build"],
      "outputs": []
    },
    "test:integration": {
      "dependsOn": ["^build"],
      "cache": false,
      "outputs": [],
      "env": [
        "DATABASE_URL",
        "DATABASE_URL_UNPOOLED",
        "REDIS_URL",
        "RIVET_ALLOW_REMOTE_INTEGRATION",
        "RIVET_TEST_LOG_LEVEL"
      ]
    },
    "test:sandbox": {
      "dependsOn": ["^build"],
      "cache": false,
      "outputs": [],
      "env": [
        "DOCKER_HOST",
        "RIVET_ALLOW_REMOTE_SANDBOX",
        "RIVET_TEST_LOG_LEVEL",
        "SANDBOX_IMAGE",
        "SANDBOX_WORKDIR",
        "SANDBOX_MEMORY_MB",
        "SANDBOX_CPUS",
        "SANDBOX_PIDS_LIMIT",
        "SANDBOX_COMMAND_TIMEOUT_MS",
        "SANDBOX_CLONE_TIMEOUT_MS",
        "SANDBOX_INSTALL_TIMEOUT_MS",
        "SANDBOX_BASELINE_TIMEOUT_MS",
        "SANDBOX_MAX_OUTPUT_BYTES"
      ]
    }
  }
}
