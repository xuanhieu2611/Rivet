      "targets": [
        {
          "editorMode": "code",
          "expr": "sum by (rivet_agent_provider, rivet_agent_model) (increase({__name__=~\"rivet_job_cost_usd(_total)?\"}[$__range]))",
          "legendFormat": "{{rivet_agent_provider}} / {{rivet_agent_model}}",
