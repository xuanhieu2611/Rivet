{
  "name": "rivet",
  "version": "0.0.0",
  "private": true,
  "license": "MIT",
  "type": "module",
  "packageManager": "pnpm@10.32.0",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev",
    "demo:agent": "pnpm --filter @rivet/worker exec tsx src/agent-smoke.ts",
    "demo:job": "pnpm --filter @rivet/worker exec tsx src/job-demo.ts",
    "demo:recovery": "pnpm --filter @rivet/worker exec tsx src/recovery-demo.ts",
    "demo:pr": "pnpm --filter @rivet/worker exec tsx src/pr-demo.ts",
    "demo:observability": "pnpm --filter @rivet/worker exec tsx src/observability-demo.ts",
    "eval:build": "pnpm --filter @rivet/worker eval:build",
    "eval:run": "pnpm --filter @rivet/worker eval:run",
    "eval:grade": "pnpm --filter @rivet/worker eval:grade",
    "eval:label": "pnpm --filter @rivet/worker eval:label",
    "demo:eval": "pnpm --filter @rivet/worker demo:eval",
    "demo:capture": "pnpm --filter @rivet/worker demo:capture",
    "demo:replay": "pnpm --filter @rivet/worker demo:replay",
    "obs:up": "docker compose -f ops/observability/docker-compose.yml up -d",
    "obs:down": "docker compose -f ops/observability/docker-compose.yml down --remove-orphans",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "test:integration": "turbo run test:integration",
    "test:sandbox": "turbo run test:sandbox",
    "test:streaming": "turbo run test:streaming",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "db:generate": "pnpm --filter @rivet/database db:generate",
    "db:migrate": "pnpm --filter @rivet/database db:migrate",
    "db:studio": "pnpm --filter @rivet/database db:studio"
  },
  "devDependencies": {
    "prettier": "^3.9.6",
    "turbo": "^2.10.9",
    "typescript": "^7.0.2"
  }
}
